# Copy this file to ".env" and fill in your Alpaca PAPER keys.
# (Get them at https://alpaca.markets → Paper Trading → API Keys.)
# NEVER put live/real-money keys here — this agent is paper-only.

AGENT_MODE=DRY_RUN
# switch to LIVE_PAPER only after your paper account + keys are set up

ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
