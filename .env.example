# Copy this file to .env and fill in your Alpaca PAPER keys.
#   cp .env.example .env
# NEVER commit .env — it is git-ignored on purpose. Paper keys only; no real money.
# Get keys at https://app.alpaca.markets  (Paper account → API Keys → generate).

# DRY_RUN = no orders, just prints what it would do.  LIVE_PAPER = paper trades via MCP.
AGENT_MODE=DRY_RUN

# Account A (options-only, the pure V1 research account)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Account B (options + crypto experiment). Optional — falls back to the A keys above
# if unset, but a separate paper account keeps A's research record clean.
# ALPACA_B_API_KEY=your_account_b_paper_key_here
# ALPACA_B_SECRET_KEY=your_account_b_paper_secret_here

# Dashboard access token. REQUIRED for any public deploy: the dashboard refuses to
# start when $PORT is set (a host like Render) unless this is set, so account data is
# never world-readable by accident. Leave unset for local runs (they bind 127.0.0.1).
# DASH_TOKEN=change-me-to-a-long-random-string

# Optional: Discord webhook — the agent pings you when it buys or closes a position.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
